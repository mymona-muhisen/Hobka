---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { ui, path } from '../i18n/ui';
import { type Lang } from '../config/catalog';
import { getSettings } from '../lib/settings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const { contact } = await getSettings(Astro.locals);
const home = path(lang, '/');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <Logo class="flogo" label="Hobka" />
      <p>{t.footer.about}</p>
    </div>
    <nav aria-label={t.footer.links}>
      <h2>{t.footer.links}</h2>
      <ul>
        <li><a href={`${home}#boxes`}>{t.nav.boxes}</a></li>
        <li><a href={`${home}#how`}>{t.nav.how}</a></li>
        <li><a href={path(lang, '/habbouk')}>{t.nav.habbouk}</a></li>
        <li><a href={path(lang, '/privacy')}>{t.footer.privacy}</a></li>
        <li><a href={path(lang, '/terms')}>{t.footer.terms}</a></li>
      </ul>
    </nav>
    <div>
      <h2>{t.footer.contact}</h2>
      <ul class="social">
        <li><a href={`https://wa.me/${contact.whatsapp}`} rel="noopener" target="_blank"><Icon name="chat" />{t.common.whatsapp} <span class="ltr">{contact.whatsappDisplay}</span></a></li>
        <li><a href={contact.instagram} rel="noopener" target="_blank"><Icon name="camera" />{t.common.instagram}</a></li>
        <li><a href={contact.facebook} rel="noopener" target="_blank"><Icon name="facebook" />{t.common.facebook}</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">© {year} Hobka · {t.footer.rights}</div>
</footer>

<style>
  .site-footer { background: var(--color-brand-dark); color: #f6e4ea; padding-block: var(--space-16) var(--space-6); margin-top: 0; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: var(--space-12); }
  .site-footer :global(.flogo) { width: 130px; color: var(--color-rose); margin-bottom: var(--space-4); }
  h2 { font-family: var(--font-body); font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  a { color: #f6e4ea; text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  .social a { display: inline-flex; gap: var(--space-2); align-items: center; }
  .social :global(svg) { width: 20px; height: 20px; }
  .legal { border-top: 1px solid rgb(255 255 255 / 15%); margin-top: var(--space-12); padding-top: var(--space-6); font-size: 0.9rem; color: #d9bcc6; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; gap: var(--space-8); } }
</style>
