---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { ui, path } from '../i18n/ui';
import type { Lang } from '../config/catalog';

interface Props { lang: Lang; altPath?: string }
const { lang, altPath } = Astro.props;
const t = ui[lang];
const home = path(lang, '/');
const links = [
  { href: `${home}#boxes`, label: t.nav.boxes },
  { href: `${home}#how`, label: t.nav.how },
  { href: path(lang, '/habbouk'), label: t.nav.habbouk },
  { href: `${home}#faq`, label: t.nav.faq },
];
const other = altPath ?? (lang === 'ar' ? '/en' : '/');
---
<header class="site-header">
  <div class="container bar">
    <a href={home} class="brand" aria-label={lang === 'ar' ? 'حبكة، الرئيسية' : 'Hobka, home'}>
      <Logo class="brand-logo" label="Hobka" />
    </a>
    <nav class="nav" aria-label={lang === 'ar' ? 'التنقل الرئيسي' : 'Main'}>
      <ul id="nav-list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li class="lang"><a href={other} hreflang={lang === 'ar' ? 'en' : 'ar'} lang={lang === 'ar' ? 'en' : 'ar'}>{t.otherLang}</a></li>
      </ul>
    </nav>
    <a class="btn btn-primary cta" href={path(lang, '/order')}>{t.nav.order}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-list" data-open={t.nav.menu} data-close={t.nav.close}>
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      <span class="sr-only">{t.nav.menu}</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('open', open);
    const label = btn.querySelector('.sr-only');
    if (label) label.textContent = (open ? btn.dataset.close : btn.dataset.open) ?? '';
  });
  document.querySelectorAll('#nav-list a').forEach((a) =>
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('open');
    }),
  );
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(255 248 242 / 92%); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-border); }
  .bar { display: flex; align-items: center; gap: var(--space-6); min-height: 72px; }
  .brand { display: block; width: 116px; flex: none; }
  .nav { margin-inline-start: auto; }
  .nav ul { display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0; align-items: center; }
  .nav a { color: var(--color-ink); text-decoration: none; font-weight: 500; }
  .nav a:hover { color: var(--color-brand); }
  .lang a { border: 1px solid var(--color-border); border-radius: 999px; padding: 0.2rem 0.8rem; font-size: 0.95rem; }
  .cta { min-height: 44px; padding-inline: var(--space-4); font-size: 0.98rem; box-shadow: 0 4px 0 var(--color-brand-dark); }
  .menu-btn { display: none; background: none; border: 0; width: 44px; height: 44px; padding: 10px; color: var(--color-brand-dark); cursor: pointer; }
  .menu-btn :global(.i-close) { display: none; }

  @media (max-width: 900px) {
    .bar { gap: var(--space-3); min-height: 64px; }
    .brand { width: 96px; }
    .cta { margin-inline-start: auto; font-size: 0.9rem; padding-inline: var(--space-3); min-height: 40px; }
    .menu-btn { display: block; }
    .nav { position: absolute; inset-inline: 0; top: 100%; background: var(--color-paper); border-bottom: 1px solid var(--color-border); display: none; }
    .site-header.open .nav { display: block; }
    .site-header.open .menu-btn :global(.i-open) { display: none; }
    .site-header.open .menu-btn :global(.i-close) { display: block; }
    .nav ul { flex-direction: column; align-items: stretch; gap: 0; padding: var(--space-2) var(--gutter) var(--space-4); }
    .nav li a { display: block; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); }
    .lang a { border: 0; border-radius: 0; padding: var(--space-3) 0; }
  }
  @media (max-width: 380px) { .cta { display: none; } .menu-btn { margin-inline-start: auto; } }
</style>
