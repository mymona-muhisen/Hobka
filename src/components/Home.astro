---
import Icon from './Icon.astro';
import heart from '../assets/heart.svg?raw';
import { ui, path, fill } from '../i18n/ui';
import { contact, photoRetentionDays, type Lang, type Catalog } from '../config/catalog';
import { money, activeBoxes, productImage } from '../lib/pricing';
import { getSettings, activeValues } from '../lib/settings';

interface Props { lang: Lang; catalog: Catalog }
const { lang, catalog } = Astro.props;
const items = catalog.items;
const boxes = activeBoxes(catalog);
const t = ui[lang];
const settings = await getSettings(Astro.locals);
const { timing, pricesAreFinal } = settings;
// A short line of story values, situational ones first (they are what makes parents say "this is what we need now").
const allValues = activeValues(settings);
const PREFER = ['sleep', 'sibling', 'screens', 'courage', 'confidence', 'patience', 'friendship', 'prayer'];
const shownValues = [...PREFER.map((id) => allValues.find((v) => v.id === id)).filter((v) => !!v), ...allValues.filter((v) => !PREFER.includes(v.id))].slice(0, 8);
const moreValues = allValues.length - shownValues.length;
const arCount = (n: number) => (n === 1 ? 'وقيمة أخرى' : n === 2 ? 'وقيمتان أخريان' : n <= 10 ? `و${n} قيم أخرى` : `و${n} قيمة أخرى`);
const moreText = moreValues > 0
  ? (lang === 'ar' ? `${arCount(moreValues)}، أو فكرتك الخاصة` : fill(t.boxes.valuesMore, { n: moreValues }))
  : (lang === 'ar' ? 'أو فكرتك الخاصة' : 'or your own idea');
const vars = { draft: timing.draftDays[lang], print: timing.printDays[lang], days: photoRetentionDays };
const orderHref = path(lang, '/order');
const standalone = Object.values(items).filter((i) => i.standalone && i.status === 'available' && i.addonPrice !== null).sort((a, b) => a.sort - b.sort);
---
<!-- Hero -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="mini-heart" set:html={heart} />{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.text}</p>
      <div class="actions">
        <a class="btn btn-primary" href={orderHref}>{t.hero.cta}<Icon name="arrow" class="dir-arrow" /></a>
        <a class="btn btn-secondary" href="#boxes">{t.hero.cta2}</a>
      </div>
      <p class="hero-note"><Icon name="check" />{t.hero.note}</p>
    </div>
    <div class="hero-media">
      <div class="blob" aria-hidden="true"></div>
      <picture>
        <source media="(max-width: 700px)" srcset="/images/hero-book-sm.webp" />
        <img src="/images/hero-book.webp" width="1400" height="933" alt={t.hero.imgAlt} fetchpriority="high" />
      </picture>
    </div>
  </div>
</section>

<!-- Value strip -->
<section class="strip" aria-label={lang === 'ar' ? 'لماذا حبكة' : 'Why Hobka'}>
  <div class="container strip-grid">
    {t.values3.map((v, i) => (
      <div class="strip-item">
        <span class="strip-icon"><Icon name={(['star', 'heart', 'check'] as const)[i]} /></span>
        <div><h3>{v.t}</h3><p>{v.d}</p></div>
      </div>
    ))}
  </div>
</section>

<!-- Boxes -->
<section class="section" id="boxes">
  <div class="container">
    <div class="section-head center">
      <h2>{t.boxes.title}</h2>
      <p>{t.boxes.sub}</p>
    </div>
    <div class="boxes">
      {boxes.map((b) => (
        <article class:list={['box', { popular: b.popular }]}>
          {b.popular && <span class="badge pop">{t.boxes.popular}</span>}
          {productImage('box', b) && <img class="box-img" src={productImage('box', b)!} alt={b.name[lang]} loading="lazy" width="600" height="450" />}
          <h3>{b.name[lang]}</h3>
          <p class="tagline">{b.tagline[lang]}</p>
          <p class="price"><span>{money(b.price, lang)}</span><small>{t.boxes.shipping}</small></p>
          <ul>
            {b.includes.map((id) => (
              <li class:list={{ soon: items[id].status === 'soon' }}>
                <Icon name="check" />
                <span>{items[id].name[lang]}{items[id].status === 'soon' && <span class="badge badge-soon">{t.boxes.soon}</span>}</span>
              </li>
            ))}
          </ul>
          <a class:list={['btn', b.popular ? 'btn-primary' : 'btn-secondary', 'btn-block']} href={`${orderHref}?box=${b.id}`}>{t.boxes.choose}</a>
        </article>
      ))}
    </div>
    {!pricesAreFinal && <p class="price-note muted">{t.boxes.priceNote}</p>}
    <p class="timeline"><Icon name="truck" />{t.boxes.timeline}</p>
    <div class="values-line">
      <span class="vl-lead">{t.boxes.valuesLead}</span>
      {shownValues.map((v) => <span class="vchip"><Icon name={v.icon} />{v.name[lang]}</span>)}
      <a href={orderHref} class="vl-more">{moreText}</a>
    </div>

    <div class="standalone">
      <img src="/images/seedling.webp" width="900" height="411" alt="" loading="lazy" class="st-img" />
      <div>
        <h3>{t.standalone.title}</h3>
        <p class="muted">{t.standalone.sub}</p>
      </div>
      <ul>
        {standalone.map((s) => <li>{productImage('item', s) && <img class="sa-img" src={productImage('item', s)!} alt="" loading="lazy" width="48" height="48" />}<span><strong>{s.name[lang]}</strong> <span class="muted">{money(s.addonPrice ?? 0, lang)}</span></span></li>)}
      </ul>
      <a class="btn btn-secondary" href={`${orderHref}?only=1`}>{t.standalone.cta}</a>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section how" id="how">
  <div class="container">
    <div class="section-head center"><h2>{t.how.title}</h2></div>
    <ol class="steps">
      {t.how.steps.map((s, i) => (
        <li class="step">
          <span class="num" aria-hidden="true">{lang === 'ar' ? '١٢٣٤'[i] : i + 1}</span>
          <h3>{fill(s.t, vars)}</h3>
          <p>{fill(s.d, vars)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Surprise -->
<section class="section surprise">
  <div class="container sp-grid">
    <img src="/images/surprise.webp" width="1200" height="675" alt={t.surprise.imgAlt} loading="lazy" class="sp-img" />
    <div>
      <p class="eyebrow"><Icon name="eye" />{lang === 'ar' ? 'ما الذي نعرضه عليك قبل الطباعة؟' : 'What do we show you before printing?'}</p>
      <h2>{t.surprise.title}</h2>
      <p class="lead">{t.surprise.text}</p>
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="section gallery">
  <div class="container">
    <div class="section-head center">
      <h2>{t.gallery.title}</h2>
      <p>{t.gallery.sub}</p>
    </div>
    <div class="gal">
      <img class="g1" src="/images/kit.webp" width="1000" height="1067" alt={t.gallery.kitAlt} loading="lazy" />
      <img class="g2" src="/images/girl-reading.webp" width="1000" height="782" alt={t.gallery.girlAlt} loading="lazy" />
      <img class="g3" src="/images/book-doctor.webp" width="1000" height="667" alt={t.gallery.doctorAlt} loading="lazy" />
      <img class="g4" src="/images/gift.webp" width="900" height="900" alt={t.gallery.giftAlt} loading="lazy" />
    </div>
  </div>
</section>

<!-- Habbouk -->
<section class="section habbouk" id="habbouk">
  <div class="container hb-grid">
    <img src="/images/habbouk.webp" width="520" height="607" alt={t.habbouk.imgAlt} loading="lazy" class="hb-img" />
    <div>
      <h2>{t.habbouk.title}</h2>
      <p class="lead">{t.habbouk.text}</p>
      <div class="actions">
        <a class="btn btn-primary" href={contact.arUrl}><Icon name="camera" />{t.habbouk.cta}</a>
        <a class="btn btn-secondary" href={path(lang, '/habbouk')}>{t.habbouk.more}</a>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-head center"><h2>{t.faq.title}</h2></div>
    <div class="faq">
      {t.faq.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{fill(f.a, vars)}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="final">
  <div class="container final-inner">
    <span class="final-heart" aria-hidden="true" set:html={heart} />
    <h2>{t.finalCta.title}</h2>
    <p>{t.finalCta.text}</p>
    <a class="btn btn-primary" href={orderHref}>{t.finalCta.cta}</a>
  </div>
</section>

<style>
  .mini-heart { display: inline-block; width: 22px; color: var(--color-brand); }
  .mini-heart :global(svg) { width: 100%; height: auto; }
  :global([dir='rtl'] .dir-arrow) { transform: scaleX(-1); }

  /* Hero */
  .hero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .lead { font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--color-muted); max-width: 34ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .hero-note { display: flex; gap: var(--space-2); align-items: center; margin-top: var(--space-6); color: var(--color-success); font-weight: 500; }
  .hero-note :global(svg) { width: 22px; height: 22px; flex: none; }
  .hero-media { position: relative; }
  .hero-media img { position: relative; border-radius: var(--radius-xl); box-shadow: var(--shadow-lift); aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  .blob { position: absolute; inset: -8% -6% -10% -10%; background: var(--color-rose); border-radius: 46% 54% 42% 58% / 52% 40% 60% 48%; transform: rotate(-4deg); animation: blob-float 8s ease-in-out infinite; will-change: transform; }
  @keyframes blob-float { 0%, 100% { transform: translateY(10px) rotate(-4deg); } 50% { transform: translateY(-14px) rotate(-2deg); } }

  /* Strip */
  .strip { background: var(--color-white); border-block: 1px solid var(--color-border); }
  .strip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); padding-block: var(--space-8); }
  .strip-item { display: flex; gap: var(--space-4); align-items: flex-start; }
  .strip-item h3 { font-family: var(--font-body); font-size: 1.1rem; margin-bottom: var(--space-1); }
  .strip-item p { margin: 0; color: var(--color-muted); font-size: 0.98rem; }
  .strip-icon { flex: none; width: 48px; height: 48px; border-radius: 50%; background: var(--color-rose-soft); color: var(--color-brand); display: grid; place-items: center; }
  .strip-icon :global(svg) { width: 24px; height: 24px; }

  /* Boxes */
  .boxes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); align-items: stretch; }
  .box { position: relative; display: flex; flex-direction: column; background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-8) var(--space-6) var(--space-6); }
  .box-img { width: calc(100% + 2 * var(--space-6) - 2px); max-width: none; margin: calc(-1 * var(--space-8) + 1px) calc(-1 * var(--space-6) + 1px) var(--space-4); aspect-ratio: 4 / 3; object-fit: cover; border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0 0; }
  .box.popular .box-img { width: calc(100% + 2 * var(--space-6) - 4px); margin-inline: calc(-1 * var(--space-6) + 2px); margin-top: calc(-1 * var(--space-8) + 2px); }
  .box.popular { border: 2px solid var(--color-brand); box-shadow: var(--shadow-lift); background: linear-gradient(180deg, var(--color-rose-soft), var(--color-white) 40%); }
  .pop { position: absolute; z-index: 1; top: -14px; inset-inline-start: var(--space-6); background: var(--color-brand); color: #fff; }
  .tagline { color: var(--color-muted); min-height: 3.4em; }
  .price { display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-4); }
  .price span { font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; color: var(--color-brand-dark); line-height: 1; }
  .price small { color: var(--color-muted); font-size: 0.9rem; }
  .box ul { list-style: none; padding: 0; margin: 0 0 var(--space-6); display: grid; gap: var(--space-2); flex: 1; align-content: start; }
  .box li { display: flex; gap: var(--space-2); align-items: flex-start; }
  .box li :global(svg) { width: 20px; height: 20px; color: var(--color-success); flex: none; margin-top: 4px; }
  .box li.soon { color: var(--color-muted); }
  .box li .badge { margin-inline-start: var(--space-2); font-size: 0.75rem; }
  .price-note { text-align: center; margin-top: var(--space-4); font-size: 0.95rem; }
  .timeline { display: flex; justify-content: center; align-items: center; gap: var(--space-2); margin: var(--space-2) 0 0; color: var(--color-brand-dark); font-weight: 500; text-align: center; }
  .timeline :global(svg) { width: 20px; height: 20px; flex: none; color: var(--color-brand); }
  .values-line { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-2); margin: var(--space-8) auto 0; max-width: 900px; }
  .vl-lead { font-weight: 700; color: var(--color-brand-dark); margin-inline-end: var(--space-1); }
  .vchip { display: inline-flex; align-items: center; gap: 6px; background: var(--color-white); border: 1px solid var(--color-border); border-radius: 999px; padding: 0.3rem 0.8rem; font-size: 0.95rem; }
  .vchip :global(svg) { width: 16px; height: 16px; color: var(--color-brand); }
  .vl-more { font-weight: 700; color: var(--color-brand); }
  .standalone { margin-top: var(--space-12); display: grid; grid-template-columns: 200px 1.2fr 1.2fr auto; gap: var(--space-6); align-items: center; background: var(--color-sage); border-radius: var(--radius-lg); padding: var(--space-6) var(--space-8); }
  .st-img { width: 200px; height: 120px; object-fit: cover; border-radius: var(--radius-md); }
  .standalone h3 { margin-bottom: var(--space-1); }
  .standalone p { margin: 0; }
  .standalone ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .standalone li { display: flex; align-items: center; gap: var(--space-3); }
  .sa-img { width: 48px; height: 48px; border-radius: 12px; object-fit: cover; flex: none; }

  /* How */
  .how { background: var(--color-white); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); counter-reset: s; }
  .step { position: relative; padding: var(--space-6); border-radius: var(--radius-lg); background: var(--color-paper); }
  .num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-brand); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; margin-bottom: var(--space-4); }
  .step p { color: var(--color-muted); margin: 0; }

  /* Surprise */
  .sp-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .sp-img { width: 100%; border-radius: var(--radius-xl); box-shadow: var(--shadow-lift); aspect-ratio: 16 / 10; object-fit: cover; }
  .surprise .eyebrow :global(svg) { width: 20px; height: 20px; }

  /* Gallery */
  .gallery { background: var(--color-rose-soft); }
  .gal { display: grid; grid-template-columns: 1.1fr 1fr 1fr; grid-template-rows: auto auto; gap: var(--space-4); }
  .gal img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-lg); }
  .g1 { grid-row: span 2; object-fit: contain !important; background: #f7e6ea; }
  .g2 { aspect-ratio: 4 / 3; }
  .g3 { aspect-ratio: 4 / 3; }
  .g4 { grid-column: span 2; aspect-ratio: 21 / 9; }

  /* Habbouk */
  .hb-grid { display: grid; grid-template-columns: auto 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; max-width: 980px; }
  .hb-img { width: clamp(180px, 26vw, 300px); filter: drop-shadow(0 16px 20px rgb(78 13 28 / 20%)); animation: bob 3s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-10px); } }

  /* FAQ */
  .narrow { max-width: 820px; }
  .faq { display: grid; gap: var(--space-3); }
  details { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 0 var(--space-6); }
  summary { cursor: pointer; font-weight: 700; padding: var(--space-4) 0; list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.5rem; line-height: 1; color: var(--color-brand); }
  details[open] summary::after { content: '−'; }
  details p { color: var(--color-muted); padding-bottom: var(--space-4); margin: 0; }

  /* Final */
  .final { background: var(--color-brand); color: #fff; text-align: center; padding-block: clamp(3.5rem, 8vw, 6rem); position: relative; overflow: hidden; }
  .final h2 { color: #fff; }
  .final p { color: #f6dce4; font-size: 1.15rem; }
  .final .btn-primary { background: var(--color-rose); color: var(--color-brand-dark); box-shadow: 0 6px 0 #c48b9c; }
  .final .btn-primary:hover { background: #fff; }
  .final-heart { display: block; width: 70px; margin: 0 auto var(--space-4); color: var(--color-rose); }
  .final-heart :global(svg) { width: 100%; height: auto; }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .boxes { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    .standalone { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-media { order: -1; margin-inline: var(--space-2); }
    .strip-grid { grid-template-columns: 1fr; gap: var(--space-4); padding-block: var(--space-6); }
    .steps { grid-template-columns: 1fr; }
    .gal { grid-template-columns: 1fr 1fr; }
    .g1 { grid-row: auto; grid-column: span 2; aspect-ratio: 1; }
    .g4 { grid-column: span 2; aspect-ratio: 16 / 9; }
    .hb-grid { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .sp-grid { grid-template-columns: 1fr; }
    .st-img { width: 100%; height: 140px; }
    .hb-grid .actions { justify-content: center; }
    .tagline { min-height: 0; }
  }
</style>
