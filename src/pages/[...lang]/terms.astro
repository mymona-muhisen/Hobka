---
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { type Lang } from '../../config/catalog';
import { getSettings } from '../../lib/settings';
export const prerender = false;
if (Astro.params.lang && Astro.params.lang !== 'en') return new Response(null, { status: 404 });
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'ar';
const { timing } = await getSettings(Astro.locals);
---
<Base lang={lang} title={lang === 'ar' ? 'شروط الطلب | حبكة' : 'Order terms | Hobka'} altPath={lang === 'ar' ? '/en/terms' : '/terms'}>
  {lang === 'ar' ? (
    <Prose title="شروط الطلب" lang="ar">
      <h2>كيف يتم الطلب</h2>
      <ol>
        <li>ترسل الطلب من الموقع، دون أي دفع.</li>
        <li>نرسل لك خلال {timing.draftDays.ar}، على رابط خاص، شكل طفلك كما سيظهر في الرسم. الحكاية نفسها تبقى مفاجأة ولا تُعرض قبل الطباعة.</li>
        <li>توافق على الشبه، أو تكتب ملاحظاتك فنعدّل الرسمة ونرسلها من جديد.</li>
        <li>بعد موافقتك تدفع المبلغ كاملاً بالتحويل (شام كاش أو حوالة)، وتصلك تفاصيل الدفع على واتساب.</li>
        <li>نبدأ الطباعة بعد وصول الدفعة، وتستغرق {timing.printDays.ar}، ثم نوصل الطلب أو نشحنه.</li>
      </ol>
      <h2>الأسعار والشحن</h2>
      <p>الأسعار بالدولار الأمريكي كما تظهر عند الطلب. تكلفة الشحن التي تظهر تقريبية وتختلف حسب المحافظة، والسعر النهائي تحدده شركة الشحن ونؤكده لك قبل الدفع.</p>
      <h2>الإلغاء</h2>
      <p>يمكنك إلغاء الطلب مجاناً في أي وقت قبل الدفع. بعد بدء الطباعة لا يمكن الإلغاء، لأن كل قصة تُصنع خصيصاً لطفلك.</p>
      <h2>إذا وصل شيء تالفاً</h2>
      <p>راسلنا على واتساب مع صورة للمشكلة فور الاستلام، وسنجد حلاً معك.</p>
    </Prose>
  ) : (
    <Prose title="Order terms" lang="en">
      <h2>How ordering works</h2>
      <ol>
        <li>You send the order from the website, with no payment.</li>
        <li>Within {timing.draftDays.en} we send you, on a private link, your child’s look as it will appear in the illustrations. The story itself stays a surprise and is not shown before printing.</li>
        <li>You approve the likeness, or write your notes and we adjust the drawing and send it again.</li>
        <li>After your approval you pay the full amount by transfer (Sham Cash or remittance); payment details arrive on WhatsApp.</li>
        <li>Printing starts once payment arrives and takes {timing.printDays.en}, then we deliver or ship.</li>
      </ol>
      <h2>Prices and shipping</h2>
      <p>Prices are in US dollars as shown when ordering. The shipping cost shown is approximate and depends on the governorate; the final price is set by the delivery company and confirmed before payment.</p>
      <h2>Cancellation</h2>
      <p>You can cancel for free anytime before payment. Once printing starts, orders cannot be cancelled because each story is made for your child.</p>
      <h2>If something arrives damaged</h2>
      <p>Message us on WhatsApp with a photo of the problem right after delivery, and we will find a solution together.</p>
    </Prose>
  )}
</Base>
