---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { db, env, now, logEvent, type OrderRow } from '../../../lib/db';
import { sameOrigin } from '../../../lib/auth';
import { statuses, waLink, toIntl, type Status, type ChildInput } from '../../../lib/order';
import { artStyles, photoRetentionDays } from '../../../config/catalog';
import { getSettings } from '../../../lib/settings';
import { loadCatalog } from '../../../lib/catalog';
import { orderLines, revenue, profit } from '../../../lib/orderLines';
import { money } from '../../../lib/pricing';
import { sanitizeImage } from '../../../lib/image';

export const prerender = false;

const code = String(Astro.params.code ?? '').toUpperCase();
const d = await db();
const load = () => d.prepare('SELECT * FROM orders WHERE code = ?').bind(code).first<OrderRow>();
let order = await load();
if (!order) return new Response('الطلب غير موجود', { status: 404 });

const DRAFT_TTL = 120 * 24 * 3600;
const settings = await getSettings(Astro.locals);
const { governorates, timing } = settings;
const storyValues = settings.values;
const payment = { instructions: settings.payment };
let flash = Astro.url.searchParams.get('ok') ?? '';
let error = '';

if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const t = now();
  const o = order;
  try {
    if (action === 'status') {
      const s = String(form.get('status') ?? '');
      if (!(s in statuses)) throw new Error('حالة غير معروفة');
      await d.prepare('UPDATE orders SET status = ?, updated_at = ? WHERE id = ?').bind(s, t, o.id).run();
      await logEvent(o.id, 'admin', 'status', s);
    } else if (action === 'shipping') {
      const v = Number(String(form.get('shipping') ?? '').replace(',', '.'));
      if (!Number.isFinite(v) || v < 0 || v > 500) throw new Error('كلفة الشحن غير صحيحة.');
      const ship = Math.round(v * 100) / 100;
      const total = Math.round((o.subtotal - o.discount + ship) * 100) / 100;
      await d.prepare('UPDATE orders SET shipping = ?, total = ?, updated_at = ? WHERE id = ?').bind(ship, total, t, o.id).run();
      await logEvent(o.id, 'admin', 'shipping', `${o.shipping} ← ${ship}`);
    } else if (action === 'costs') {
      const num = (k: string) => { const v = Number(String(form.get(k) ?? '0').replace(',', '.')); if (!Number.isFinite(v) || v < 0 || v > 100000) throw new Error('قيمة تكلفة غير صحيحة.'); return Math.round(v * 100) / 100; };
      await d.prepare('UPDATE orders SET cost_total = ?, extra_cost = ?, updated_at = ? WHERE id = ?').bind(num('cost_total'), num('extra_cost'), t, o.id).run();
    } else if (action === 'notes') {
      await d.prepare('UPDATE orders SET admin_notes = ?, updated_at = ? WHERE id = ?').bind(String(form.get('admin_notes') ?? '').slice(0, 4000), t, o.id).run();
    } else if (action === 'draft') {
      const url = String(form.get('draft_url') ?? '').trim();
      if (url && !/^https:\/\//.test(url)) throw new Error('الرابط يجب أن يبدأ بـ https://');
      const msg = String(form.get('draft_message') ?? '').trim().slice(0, 2000);
      const files = form.getAll('pages').filter((f): f is File => typeof f === 'object' && f !== null && 'arrayBuffer' in f && (f as File).size > 0);
      if (!url && !files.length) throw new Error('أضيفي رسومات الشخصية أو رابطاً.');
      if (files.length > 60) throw new Error('الحد الأقصى 60 صفحة.');
      const version = o.draft_version + 1;
      for (let i = 0; i < files.length; i++) {
        if (files[i].size > 3 * 1024 * 1024) throw new Error(`الصفحة ${i + 1} أكبر من 3 ميغابايت.`);
        const clean = sanitizeImage(await files[i].arrayBuffer());
        if (!clean) throw new Error(`الصفحة ${i + 1} ليست صورة سليمة (JPG أو PNG أو WebP).`);
        await env.PHOTOS.put(`draft:${o.code}:v${version}:${i}`, clean.buf, { expirationTtl: DRAFT_TTL, metadata: { type: clean.type } });
      }
      await d.prepare("UPDATE orders SET draft_url = ?, draft_message = ?, draft_version = ?, status = 'draft_sent', updated_at = ? WHERE id = ?").bind(url || null, msg || null, version, t, o.id).run();
      if (files.length) await logEvent(o.id, 'admin', 'draft_images', `${version}:${files.length}`);
      await logEvent(o.id, 'admin', 'draft_sent', `نسخة ${version}`);
    } else if (action === 'delivery') {
      const g = (k: string, max: number) => String(form.get(k) ?? '').trim().slice(0, max);
      const gid = g('governorate', 40);
      if (g('parent_name', 60).length < 2) throw new Error('اسم ولي الأمر قصير.');
      if (!/^\+?[0-9 ()-]{7,20}$/.test(g('phone', 20))) throw new Error('رقم الهاتف غير صحيح.');
      if (!governorates.some((x) => x.id === gid)) throw new Error('المحافظة غير معروفة.');
      if (g('address', 300).length < 4) throw new Error('العنوان قصير.');
      await d.prepare('UPDATE orders SET parent_name = ?, phone = ?, governorate = ?, address = ?, notes = ?, updated_at = ? WHERE id = ?')
        .bind(g('parent_name', 60), g('phone', 20), gid, g('address', 300), g('notes', 600) || null, t, o.id).run();
      await logEvent(o.id, 'admin', 'delivery_edit', null);
    } else if (action === 'delete_order') {
      if (String(form.get('confirm_code') ?? '').trim().toUpperCase() !== o.code) throw new Error('اكتبي رقم الطلب كما هو لتأكيد الحذف.');
      for (let i = 0; i < 10; i++) await env.PHOTOS.delete(`photo:${o.code}:${i}`);
      let cursor: string | undefined;
      do {
        const page = await env.PHOTOS.list({ prefix: `draft:${o.code}:`, cursor });
        await Promise.all(page.keys.map((k) => env.PHOTOS.delete(k.name)));
        cursor = page.list_complete ? undefined : page.cursor;
      } while (cursor);
      await d.batch([d.prepare('DELETE FROM order_events WHERE order_id = ?').bind(o.id), d.prepare('DELETE FROM orders WHERE id = ?').bind(o.id)]);
      return Astro.redirect(`/admin?ok=${encodeURIComponent(`حُذف الطلب ${o.code} وكل صوره ✓`)}`, 303);
    } else if (action === 'delete_photos') {
      for (let i = 0; i < 10; i++) await env.PHOTOS.delete(`photo:${o.code}:${i}`);
      await d.prepare('UPDATE orders SET photo_count = 0, updated_at = ? WHERE id = ?').bind(t, o.id).run();
      await logEvent(o.id, 'admin', 'photos_deleted', null);
    } else {
      throw new Error('إجراء غير معروف');
    }
    return Astro.redirect(`/admin/order/${o.code}?ok=${encodeURIComponent('تم الحفظ ✓')}`, 303);
  } catch (e) {
    error = (e as Error).message;
    order = (await load())!;
  }
}

const o = order!;
const lang = o.site_lang === 'en' ? 'en' : 'ar';
const child = o.child ? (JSON.parse(o.child) as ChildInput) : null;
const cat = await loadCatalog({ includeDeleted: true });
const lines = orderLines(o, cat);
const gov = governorates.find((g) => g.id === o.governorate);
const { results: events } = await d.prepare('SELECT * FROM order_events WHERE order_id = ? ORDER BY id DESC LIMIT 50').bind(o.id).all<{ at: string; actor: string; type: string; note: string | null }>();
const draftLink = `${Astro.url.origin}/d/${o.token}`;
const phoneIntl = toIntl(o.phone);
const fmt = (iso: string) => new Date(iso).toLocaleString('ar-SY', { timeZone: 'Asia/Damascus', dateStyle: 'medium', timeStyle: 'short' });
const created = Date.parse(o.created_at);
const photosExpire = new Date(created + photoRetentionDays * 86400000);

const msgs = lang === 'en'
  ? {
      confirm: `Hello ${o.parent_name} 🌸\nWe received your order ${o.code} ✅\nWe're drawing your child and will send you their look within ${timing.draftDays.en} for your approval.`,
      draft: `Hello ${o.parent_name} 🌸\n${child ? `This is how ${child.name} will look in their story!` : 'Your child’s drawing is ready!'}\nHave a look and approve the likeness, or write your notes (the story stays a surprise 🎁):\n${draftLink}`,
      pay: `Thank you for approving the look 💛\nOrder ${o.code}\nTotal: ${money(o.total, 'en')}\n${payment.instructions.en}\nWe start printing as soon as payment arrives.`,
      shipped: `Good news! Order ${o.code} is on its way to you 📦`,
    }
  : {
      confirm: `مرحباً ${o.parent_name} 🌸\nوصلنا طلبك ${o.code} ✅\nنرسم شخصية طفلك وسنرسل لك شكله خلال ${timing.draftDays.ar} لتوافق عليه.`,
      draft: `مرحباً ${o.parent_name} 🌸\n${child ? `هكذا سيظهر ${child.name} في حكايته!` : 'رسمة طفلك جاهزة!'}\nشاهدها من هنا ووافق على الشبه، أو اكتب ملاحظاتك (الحكاية نفسها تبقى مفاجأة 🎁):\n${draftLink}`,
      pay: `شكراً لموافقتك على شكل طفلك 💛\nالطلب ${o.code}\nالمبلغ: ${money(o.total, 'ar')}\n${payment.instructions.ar}\nنبدأ الطباعة فور وصول الدفعة.`,
      shipped: `خبر جميل! طلبك ${o.code} في الطريق إليك 📦`,
    };
const eventLabel: Record<string, string> = { created: 'أُنشئ الطلب', status: 'تغيير الحالة', draft_sent: 'أُرسل شكل الطفل', draft_images: 'رسومات الشخصية', approved: 'وافق الأهل على الشكل', changes_requested: 'طلب الأهل تعديلاً', photos_deleted: 'حُذفت الصور', shipping: 'تعديل كلفة الشحن', delivery_edit: 'تعديل بيانات التوصيل' };
---
<Admin title={o.code}>
  <p><a href="/admin">→ كل الطلبات</a></p>
  {flash && <p class="flash">{flash}</p>}
  {error && <p class="flash bad" role="alert">{error}</p>}

  <div class="head">
    <h1 class="ltr">{o.code}</h1>
    <span class={`st st-${o.status}`}>{statuses[o.status as Status]?.ar}</span>
    <span class="muted">{fmt(o.created_at)} · لغة الموقع: {lang === 'en' ? 'إنجليزي' : 'عربي'}</span>
  </div>

  <div class="grid">
    <div>
      {o.feedback && (
        <section class="apanel fb">
          <h2>{o.status === 'changes_requested' ? '✏️ ملاحظات الأهل على شكل الطفل' : '💬 ملاحظة العميل'}</h2>
          <p class="pre">{o.feedback}</p>
        </section>
      )}

      {child && (
        <section class="apanel">
          <h2>الطفل والقصة</h2>
          <dl class="kv">
            <dt>الاسم</dt><dd><strong>{child.name}</strong></dd>
            <dt>الجنس والعمر</dt><dd>{child.gender === 'girl' ? 'بنت' : 'ولد'} · {child.age} سنوات</dd>
            <dt>لغة القصة</dt><dd>{child.storyLang === 'en' ? 'الإنجليزية' : 'العربية'}</dd>
            {child.values.length > 0 && <><dt>القيم</dt><dd>{child.values.map((v) => storyValues.find((x) => x.id === v)?.name.ar ?? v).join('، ')}</dd></>}
            {child.valueNote && <><dt>ملاحظة القيمة</dt><dd class="pre">{child.valueNote}</dd></>}
            {child.ownIdea && <><dt>فكرة الأهل</dt><dd class="pre">{child.ownIdea}</dd></>}
            {child.appearance && <><dt>الشكل</dt><dd class="pre">{child.appearance}</dd></>}
            {child.interests && <><dt>يحب</dt><dd>{child.interests}</dd></>}
            {child.style && <><dt>الأسلوب</dt><dd>{artStyles.find((s) => s.id === child.style)?.name.ar}</dd></>}
          </dl>
        </section>
      )}

      {o.kind === 'box' && (
        <section class="apanel">
          <h2>صور الطفل</h2>
          {o.photo_count > 0 ? (
            <>
              <div class="photos">
                {Array.from({ length: o.photo_count }, (_, i) => <a href={`/admin/photo/${o.code}/${i}`} target="_blank"><img src={`/admin/photo/${o.code}/${i}`} alt={`صورة ${i + 1}`} /></a>)}
              </div>
              <p class="muted">تُحذف تلقائياً في {photosExpire.toLocaleDateString('ar-SY', { timeZone: 'Asia/Damascus' })}. موافقة ولي الأمر: {o.photo_consent ? 'نعم ✓' : 'لا'}</p>
              <form method="post" onsubmit="return confirm('حذف صور الطفل نهائياً؟')">
                <input type="hidden" name="action" value="delete_photos" />
                <button class="abtn danger" type="submit">احذف الصور الآن</button>
              </form>
            </>
          ) : (
            <p class="muted">{o.photo_mode === 'whatsapp' ? 'سيرسل الأهل الصورة على واتساب.' : o.photo_mode === 'none' ? 'بدون صورة (الوصف فقط).' : 'لا توجد صور (حُذفت أو انتهت مدتها).'}</p>
          )}
        </section>
      )}

      <section class="apanel">
        <h2>شكل الطفل في الرسم (للموافقة)</h2>
        {o.draft_version > 0 && <p class="muted">النسخة الحالية: {o.draft_version}</p>}
        <form method="post" enctype="multipart/form-data" id="draft-form">
          <input type="hidden" name="action" value="draft" />
          <div class="afield">
            <label for="du">رابط خارجي (اختياري، مثل صورة على Google Drive)</label>
            <input id="du" name="draft_url" type="url" dir="ltr" value={o.draft_url ?? ''} placeholder="https://" />
          </div>
          <div class="afield">
            <label for="dp">رسومات شخصية الطفل (تُصغَّر تلقائياً)</label>
            <input id="dp" name="pages" type="file" accept="image/*" multiple />
          </div>
          <div class="afield">
            <label for="dm">رسالة تظهر للأهل فوق الرسومات (اختياري)</label>
            <textarea id="dm" name="draft_message" rows="2">{o.draft_message ?? ''}</textarea>
          </div>
          <button class="abtn primary" type="submit">احفظ واجعل الحالة «شكل الطفل جاهز للموافقة»</button>
          <p class="muted" id="draft-progress" aria-live="polite"></p>
        </form>
        <p class="link">رابط صفحة الموافقة الخاص: <a href={draftLink} target="_blank" class="ltr">/d/{o.token.slice(0, 8)}…</a></p>
      </section>
    </div>

    <div>
      <section class="apanel">
        <h2>تواصل سريع على واتساب</h2>
        <div class="wa-list">
          <a class="abtn wa" target="_blank" rel="noopener" href={waLink(phoneIntl, msgs.confirm)}><Icon name="chat" />تأكيد استلام الطلب</a>
          <a class="abtn wa" target="_blank" rel="noopener" href={waLink(phoneIntl, msgs.draft)}><Icon name="chat" />إرسال رابط شكل الطفل</a>
          <a class="abtn wa" target="_blank" rel="noopener" href={waLink(phoneIntl, msgs.pay)}><Icon name="chat" />إرسال تفاصيل الدفع</a>
          <a class="abtn wa" target="_blank" rel="noopener" href={waLink(phoneIntl, msgs.shipped)}><Icon name="chat" />تم الشحن</a>
          <a class="abtn" target="_blank" rel="noopener" href={`https://wa.me/${phoneIntl}`}>محادثة فارغة</a>
        </div>
      </section>

      <section class="apanel">
        <h2>الحالة</h2>
        <form method="post" class="row">
          <input type="hidden" name="action" value="status" />
          <select name="status" aria-label="الحالة">
            {Object.entries(statuses).map(([k, v]) => <option value={k} selected={o.status === k}>{v.ar}</option>)}
          </select>
          <button class="abtn primary" type="submit">حفظ</button>
        </form>
      </section>

      <section class="apanel">
        <h2>الطلب والمبلغ</h2>
        <ul class="lines">
          {lines.map((l) => <li><span>{l.name_ar}</span><span>{money(l.price)}</span></li>)}
          <li><span>الشحن ({gov?.name.ar})</span><span>{money(o.shipping)}</span></li>
          {o.discount > 0 && <li><span>خصم <span class="ltr">{o.discount_code}</span></span><span>−{money(o.discount)}</span></li>}
          <li class="total"><span>المجموع</span><span>{money(o.total)}</span></li>
        </ul>
        <p class="muted small">الأسعار محفوظة كما كانت لحظة الطلب. الشحن تقريبي: عدّليه حسب سعر الشركة قبل إرسال تفاصيل الدفع.</p>
        <form method="post" class="row ship">
          <input type="hidden" name="action" value="shipping" />
          <label class="sr-only" for="ship">كلفة الشحن الفعلية</label>
          <input id="ship" name="shipping" type="number" step="0.5" min="0" inputmode="decimal" value={o.shipping} />
          <button class="abtn" type="submit">تعديل الشحن</button>
        </form>
      </section>

      <section class="apanel">
        <h2>الربح من هذا الطلب</h2>
        <ul class="lines">
          <li><span>المبيعات (بعد الخصم، بدون الشحن)</span><span>{money(revenue(o))}</span></li>
          <li><span>تكلفة المنتجات</span><span>−{money(o.cost_total ?? 0)}</span></li>
          <li><span>تكاليف إضافية</span><span>−{money(o.extra_cost ?? 0)}</span></li>
          <li class:list={['total', { neg: profit(o) < 0 }]}><span>صافي الربح</span><span>{money(profit(o))}</span></li>
        </ul>
        <form method="post" class="costs">
          <input type="hidden" name="action" value="costs" />
          <label>تكلفة المنتجات<input name="cost_total" type="number" step="0.01" min="0" inputmode="decimal" value={o.cost_total ?? 0} /></label>
          <label>تكاليف إضافية (تغليف، مواصلات…)<input name="extra_cost" type="number" step="0.01" min="0" inputmode="decimal" value={o.extra_cost ?? 0} /></label>
          <button class="abtn" type="submit">حفظ التكاليف</button>
        </form>
        <p class="muted small">تكلفة المنتجات تُحسب تلقائياً من تكاليف المنتجات لحظة الطلب، ويمكنك تصحيحها هنا. الشحن لا يدخل في الربح لأنه يذهب لشركة الشحن.</p>
      </section>

      <section class="apanel">
        <h2>ولي الأمر والتوصيل</h2>
        <dl class="kv">
          <dt>الاسم</dt><dd>{o.parent_name}</dd>
          <dt>الهاتف</dt><dd class="ltr"><a href={`tel:${o.phone}`}>{o.phone}</a></dd>
          <dt>المحافظة</dt><dd>{gov?.name.ar}</dd>
          <dt>العنوان</dt><dd class="pre">{o.address}</dd>
          {o.notes && <><dt>ملاحظات</dt><dd class="pre">{o.notes}</dd></>}
        </dl>
        <details class="edit">
          <summary>تعديل بيانات التوصيل</summary>
          <form method="post" class="dform">
            <input type="hidden" name="action" value="delivery" />
            <label>الاسم<input name="parent_name" value={o.parent_name} required maxlength="60" /></label>
            <label>الهاتف<input name="phone" value={o.phone} dir="ltr" required maxlength="20" /></label>
            <label>المحافظة<select name="governorate">{governorates.map((g) => <option value={g.id} selected={g.id === o.governorate}>{g.name.ar}</option>)}</select></label>
            <label>العنوان<textarea name="address" rows="2" maxlength="300" required>{o.address}</textarea></label>
            <label>ملاحظات<textarea name="notes" rows="2" maxlength="600">{o.notes ?? ''}</textarea></label>
            <button class="abtn" type="submit">حفظ</button>
          </form>
          <p class="muted small">تغيير المحافظة لا يغيّر كلفة الشحن تلقائياً؛ عدّليها من قسم «الطلب والمبلغ».</p>
        </details>
      </section>

      <section class="apanel">
        <h2>ملاحظاتي الداخلية</h2>
        <form method="post">
          <input type="hidden" name="action" value="notes" />
          <textarea name="admin_notes" rows="3" class="full" aria-label="ملاحظات داخلية">{o.admin_notes ?? ''}</textarea>
          <button class="abtn" type="submit">حفظ الملاحظات</button>
        </form>
      </section>

      <section class="apanel danger-zone">
        <h2>حذف الطلب</h2>
        <p class="muted small">يحذف الطلب وصور الطفل ورسومات الشخصية نهائياً، ولا يمكن التراجع. مناسب للطلبات التجريبية أو المكررة. لإيقاف طلب حقيقي استخدمي حالة «ملغى» بدلاً من الحذف، كي يبقى في الأرباح والسجل.</p>
        <form method="post" class="row" onsubmit="return confirm('حذف هذا الطلب نهائياً؟')">
          <input type="hidden" name="action" value="delete_order" />
          <label class="sr-only" for="cc">اكتبي رقم الطلب للتأكيد</label>
          <input id="cc" name="confirm_code" dir="ltr" placeholder={o.code} autocomplete="off" required />
          <button class="abtn danger" type="submit">حذف نهائي</button>
        </form>
      </section>

      <section class="apanel">
        <h2>السجل</h2>
        <ol class="events">
          {events.map((e) => <li><span class="muted">{fmt(e.at)}</span> {eventLabel[e.type] ?? e.type}{e.type === 'status' && e.note ? `: ${statuses[e.note as Status]?.ar ?? e.note}` : e.note && e.type !== 'draft_images' ? `: ${e.note}` : ''}</li>)}
        </ol>
      </section>
    </div>
  </div>
</Admin>

<script>
  // Shrink draft page images in the browser before upload (keeps each under KV/Worker limits).
  const form = document.getElementById('draft-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    const input = form.querySelector<HTMLInputElement>('input[name="pages"]')!;
    if (!input.files?.length) return;
    e.preventDefault();
    const prog = document.getElementById('draft-progress')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    const fd = new FormData();
    for (const [k, v] of new FormData(form).entries()) if (k !== 'pages') fd.append(k, v);
    const files = Array.from(input.files).sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
    for (let i = 0; i < files.length; i++) {
      prog.textContent = `نجهّز الصفحة ${i + 1} من ${files.length}…`;
      const bmp = await createImageBitmap(files[i]);
      const s = Math.min(1, 1400 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      const blob: Blob = await new Promise((r) => c.toBlob((b) => r(b!), 'image/jpeg', 0.84));
      fd.append('pages', blob, `p${String(i).padStart(3, '0')}.jpg`);
    }
    prog.textContent = 'نرفع المسودة…';
    const r = await fetch(location.pathname, { method: 'POST', body: fd });
    location.href = r.url || location.pathname;
  });
</script>

